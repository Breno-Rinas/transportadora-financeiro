# Copie para .env se precisar mudar algo. Todos os valores abaixo já são os padrões
# usados em desenvolvimento, então `npm run dev` funciona sem .env.

# Banco (docker compose: serviço `db`, porta 5433 no host)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/transportadora
# Banco usado pelos testes E2E da API (criado junto com o `db`)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/transportadora_test

# API
PORT=3333
HOST=0.0.0.0
# Fuso de negócio: "hoje" é sempre calculado nele
BUSINESS_TZ=America/Sao_Paulo
# Pasta dos arquivos enviados (relativa a apps/api quando não for absoluta)
UPLOAD_DIR=./uploads
# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173
